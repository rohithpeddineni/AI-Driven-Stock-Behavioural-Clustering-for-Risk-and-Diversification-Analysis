# Local Python environments
.venv/
venv/
env/

# Python generated files and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Notebook-generated local state
.ipynb_checkpoints/

# Local application and editor state
.streamlit/
.vscode/
.idea/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Logs, temporary files, and local exports
*.log
*.tmp
*.temp
*.swp
*.swo

# Cached raw market downloads.
# Keep the manifest; processed data and experiment results remain trackable.
data/raw/*
!data/raw/_manifest.json

# Common build/package artifacts
build/
dist/
*.egg-info/

# Explicitly not ignored:
# - data/processed/
# - experiments/**/outputs/
# - reports, plots, CSVs, and presentations generated by the project
